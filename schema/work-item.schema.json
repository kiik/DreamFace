{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kiik/DreamFace/main/schema/work-item.schema.json",
  "title": "DreamFace work item",
  "$comment": "Draft 0.1. See schema/README.md for versioning; aligned with docs/console-modes.md and RFC 0001.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "intent", "outcome"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^DF-[0-9]+(\\.[0-9]+)*$"
    },
    "title": { "type": "string" },
    "intent": { "enum": ["delegative", "procedural", "imperative", "mixed"] },
    "outcome": {
      "type": "string",
      "description": "Desired outcome or assigned responsibility."
    },
    "owner": {
      "type": ["string", "null"],
      "description": "Actor or agent responsible, when known."
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "status": { "enum": ["proposed", "active", "blocked", "completed", "superseded", "rejected"] },
    "requestRef": {
      "type": "string",
      "description": "Originating request context: a DreamFace segment id or a Layer 0 message id."
    },
    "mode": { "enum": ["plan", "build", "auto", "horde"] },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition"],
      "properties": {
        "condition": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
